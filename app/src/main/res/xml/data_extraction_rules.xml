<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Keep in sync with backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Everything else is kept, including the collection (scantrader.db) and the settings (datastore/). -->
        <!-- Encrypted with a Keystore key that never leaves the phone. -->
        <exclude domain="sharedpref" path="scantrader_secrets.xml" />
        <!-- Packs, galleries and catalogs: large and downloaded again. Tracker state stays on this phone. -->
        <exclude domain="file" path="vision" />
        <exclude domain="file" path="riftbound" />
        <exclude domain="file" path="tracker" />
        <exclude domain="file" path="catalogo-onepiece" />
        <exclude domain="file" path="catalogo-dragonball" />
        <exclude domain="file" path="catalogo-yugioh" />
        <exclude domain="file" path="catalogo-unionarena" />
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
    </cloud-backup>
    <device-transfer>
        <!-- Everything else is kept, including the collection (scantrader.db) and the settings (datastore/). -->
        <!-- Encrypted with a Keystore key that never leaves the phone. -->
        <exclude domain="sharedpref" path="scantrader_secrets.xml" />
        <!-- Packs, galleries and catalogs: large and downloaded again. Tracker state stays on this phone. -->
        <exclude domain="file" path="vision" />
        <exclude domain="file" path="riftbound" />
        <exclude domain="file" path="tracker" />
        <exclude domain="file" path="catalogo-onepiece" />
        <exclude domain="file" path="catalogo-dragonball" />
        <exclude domain="file" path="catalogo-yugioh" />
        <exclude domain="file" path="catalogo-unionarena" />
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
    </device-transfer>
</data-extraction-rules>
